{
  "rules": {
    ".read": false,
    ".write": false,
    "presence": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['name', 'mode', 'x', 'z', 'y', 'h', 'color', 't'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
        },
        "mode": {
          ".validate": "newData.isString() && newData.val().matches(/^(orbit|walk|naiwa|hole)$/)"
        },
        "x": {
          ".validate": "newData.isNumber() && newData.val() >= -700 && newData.val() <= 700"
        },
        "z": {
          ".validate": "newData.isNumber() && newData.val() >= -700 && newData.val() <= 700"
        },
        "y": {
          ".validate": "newData.isNumber() && newData.val() >= -700 && newData.val() <= 700"
        },
        "h": {
          ".validate": "newData.isNumber() && newData.val() >= -7 && newData.val() <= 7"
        },
        "car": {
          ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9]{1,12}$/)"
        },
        "color": {
          ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{6}$/)"
        },
        "t": {
          ".validate": "newData.isNumber() && newData.val() === now"
        },
        "fx": {
          ".validate": "newData.isString() && newData.val().matches(/^[es][0-9]{1,2}-[0-9]{1,4}$/)"
        },
        "ride": {
          ".validate": "newData.isString() && newData.val().length <= 128 && newData.val().matches(/^[A-Za-z0-9_-]+$/) && newData.val() !== $uid"
        },
        "rs": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 3"
        },
        "duel": {
          ".validate": "newData.isString() && newData.val().length <= 128 && newData.val().matches(/^[A-Za-z0-9_-]+$/) && newData.val() !== $uid"
        },
        "ds": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000"
        },
        "dnd": {
          ".validate": "newData.isBoolean()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "social": {
      "$to": {
        ".read": "auth != null && auth.uid === $to",
        "$id": {
          ".write": "auth != null && ((!data.exists() && newData.exists() && root.child('presence').child($to).exists()) || (data.exists() && !newData.exists() && (auth.uid === $to || data.child('from').val() === auth.uid || data.child('ts').val() < now - 120000)))",
          ".validate": "newData.hasChildren(['from', 'type', 'ts'])",
          "from": {
            ".validate": "newData.isString() && newData.val() === auth.uid"
          },
          "type": {
            ".validate": "newData.isString() && newData.val().matches(/^(hi|inv|ans|bye|go|end|tag|ev)$/)"
          },
          "data": {
            ".validate": "newData.isString() && newData.val().length <= 300"
          },
          "ts": {
            ".validate": "newData.isNumber() && newData.val() === now"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "looks": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.isString() && newData.val().length <= 120 && newData.val().matches(/^[a-z0-9_,]*$/)"
      }
    },
    "radio": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['s', 'k', 't', 'l'])",
        "s": {
          ".validate": "newData.isNumber() && (newData.val() === 0 || newData.val() === 1 || newData.val() === 2)"
        },
        "k": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 999999999"
        },
        "t": {
          ".validate": "newData.isNumber() && newData.val() >= now - 86400000 && newData.val() <= now + 60000"
        },
        "l": {
          ".validate": "newData.isBoolean()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "showcase": {
      ".read": "auth != null",
      ".indexOn": [
        "value"
      ],
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['name', 'car', 'look', 'wear', 'pose', 'value', 'ts'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16 && newData.val() === root.child('users').child(auth.uid).child('name').val()"
        },
        "car": {
          ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9]{0,12}$/)"
        },
        "look": {
          ".validate": "newData.isString() && newData.val().length <= 60 && newData.val().matches(/^[a-z0-9_,]*$/)"
        },
        "wear": {
          ".validate": "newData.isString() && newData.val().length <= 100 && newData.val().matches(/^[a-z0-9_,]*$/)"
        },
        "pose": {
          ".validate": "newData.isString() && newData.val().matches(/^(auto|hip|wave|cheer|show|flex)$/)"
        },
        "value": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000"
        },
        "ts": {
          ".validate": "newData.isNumber() && newData.val() === now"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "boards": {
      "$board": {
        ".read": "$board === 'hole2' || $board === 'hole' || $board === 'stunt' || $board === 'rich'",
        ".indexOn": [
          "value"
        ],
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && ($board === 'hole2' || $board === 'hole' || $board === 'stunt' || $board === 'rich')",
          ".validate": "newData.hasChildren(['name', 'value', 'ts']) && (!data.exists() || newData.child('value').val() >= data.child('value').val())",
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16 && newData.val() === root.child('users').child(auth.uid).child('name').val()"
          },
          "value": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && ((($board === 'hole' || $board === 'hole2') && newData.val() <= 100) || ($board !== 'hole' && $board !== 'hole2' && newData.val() <= 10000000))"
          },
          "ts": {
            ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now + 600000"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "mini": {
      "$game": {
        ".read": "$game.matches(/^[a-z][a-z0-9_]{1,15}$/)",
        ".indexOn": [
          "value"
        ],
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && $game.matches(/^[a-z][a-z0-9_]{1,15}$/)",
          ".validate": "newData.hasChildren(['name', 'value', 'ts']) && (!data.exists() || newData.child('value').val() >= data.child('value').val())",
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16 && newData.val() === root.child('users').child(auth.uid).child('name').val()"
          },
          "value": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
          },
          "ts": {
            ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now + 600000"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "ghosts": {
      "$track": {
        ".read": "$track.matches(/^[a-z][a-z0-9_]{1,15}$/)",
        ".indexOn": [
          "time"
        ],
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && $track.matches(/^[a-z][a-z0-9_]{1,15}$/)",
          ".validate": "newData.hasChildren(['name', 'time', 'car', 'color', 'd', 'ts']) && (!data.exists() || newData.child('time').val() <= data.child('time').val())",
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16 && newData.val() === root.child('users').child(auth.uid).child('name').val()"
          },
          "time": {
            ".validate": "newData.isNumber() && newData.val() >= 5000 && newData.val() <= 1800000"
          },
          "car": {
            ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9]{1,12}$/)"
          },
          "color": {
            ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{6}$/)"
          },
          "d": {
            ".validate": "newData.isString() && newData.val().length >= 8 && newData.val().length <= 40000 && newData.val().matches(/^[A-Za-z0-9_-]+$/)"
          },
          "ts": {
            ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now + 600000"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "wall": {
      ".read": "auth != null",
      ".indexOn": [
        "ts"
      ],
      "$uid": {
        ".write": "auth != null && auth.uid === $uid && (!newData.exists() || !data.exists() || now >= data.child('ts').val() + 600000)",
        ".validate": "newData.hasChildren(['name', 'text', 'color', 'ts'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16 && newData.val() === root.child('users').child(auth.uid).child('name').val()"
        },
        "text": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40 && newData.val().matches(/[^ ]/) && !newData.val().matches(/(https?|www|[.](com|net|org|cn|my|io|cc|xyz|top|me|co|info|link|ly|gg|app|site|shop|vip)|@|<|>|[0-9]{6})/i)"
        },
        "color": {
          ".validate": "newData.isString() && newData.val().matches(/^(yellow|pink|blue|green|orange|purple)$/)"
        },
        "ts": {
          ".validate": "newData.isNumber() && newData.val() === now"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "wallLikes": {
      "$author": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $author && !newData.exists() && newData.parent().parent().child('wall').child($author).child('ts').val() === now",
        "$liker": {
          ".write": "auth != null && auth.uid === $liker && $liker !== $author && !data.exists()",
          ".validate": "newData.val() === true && root.child('wall').child($author).exists()"
        }
      }
    },
    "wallLikeN": {
      ".read": "auth != null",
      ".indexOn": ".value",
      "$author": {
        ".write": "auth != null && newData.exists()",
        ".validate": "newData.isNumber() && ((auth.uid === $author && newData.val() === 0 && newData.parent().parent().child('wall').child($author).child('ts').val() === now) || (auth.uid !== $author && !root.child('wallLikes').child($author).child(auth.uid).exists() && newData.parent().parent().child('wallLikes').child($author).child(auth.uid).val() === true && ((!data.exists() && newData.val() === 1) || (data.exists() && newData.val() === data.val() + 1))))"
      }
    },
    "wallFlags": {
      "$author": {
        ".write": "auth != null && auth.uid === $author && !newData.exists() && newData.parent().parent().child('wall').child($author).child('ts').val() === now",
        "$reporter": {
          ".read": "auth != null && auth.uid === $reporter",
          ".write": "auth != null && auth.uid === $reporter && $reporter !== $author && !data.exists()",
          ".validate": "newData.val() === true && root.child('wall').child($author).exists()"
        }
      }
    },
    "wallFlagN": {
      ".read": "auth != null",
      ".indexOn": ".value",
      "$author": {
        ".write": "auth != null && newData.exists()",
        ".validate": "newData.isNumber() && ((auth.uid === $author && newData.val() === 0 && newData.parent().parent().child('wall').child($author).child('ts').val() === now) || (auth.uid !== $author && !root.child('wallFlags').child($author).child(auth.uid).exists() && newData.parent().parent().child('wallFlags').child($author).child(auth.uid).val() === true && ((!data.exists() && newData.val() === 1) || (data.exists() && newData.val() === data.val() + 1))))"
      }
    },
    "saves": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider !== 'anonymous'",
        ".validate": "newData.hasChildren(['data', 'score', 'ts'])",
        "data": {
          ".validate": "newData.isString() && newData.val().length <= 30000"
        },
        "score": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "ts": {
          ".validate": "newData.isNumber() && newData.val() === now"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "names": {
      ".read": "auth != null",
      "$key": {
        ".write": "auth != null && (!data.exists() || data.child('uid').val() === auth.uid)",
        ".validate": "newData.hasChildren(['uid', 'name', 'ts']) && newData.child('uid').val() === auth.uid && $key === newData.child('name').val().toLowerCase()",
        "uid": {
          ".validate": "newData.isString()"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 12 && newData.val().matches(/^[0-9A-Za-z一-龥 _·~!?-]+$/) && !newData.val().beginsWith(' ') && !newData.val().endsWith(' ') && !newData.val().contains('  ')"
        },
        "ts": {
          ".validate": "newData.val() === now"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['name', 'key']) && newData.child('key').val() === newData.child('name').val().toLowerCase() && newData.parent().parent().child('names').child(newData.child('key').val()).child('uid').val() === $uid",
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 12 && newData.val().matches(/^[0-9A-Za-z一-龥 _·~!?-]+$/) && !newData.val().beginsWith(' ') && !newData.val().endsWith(' ') && !newData.val().contains('  ')"
        },
        "key": {
          ".validate": "newData.isString()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "stats": {
      ".read": true,
      "p": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['f', 'l', 's'])",
          "f": {
            ".validate": "newData.isString() && newData.val().matches(/^20[0-9][0-9]-[01][0-9]-[0-3][0-9]$/) && (!data.exists() || newData.val() === data.val())"
          },
          "l": {
            ".validate": "newData.isString() && newData.val().matches(/^20[0-9][0-9]-[01][0-9]-[0-3][0-9]$/)"
          },
          "s": {
            ".validate": "newData.isNumber() && ((!data.exists() && newData.val() >= 0 && newData.val() <= 900) || (data.exists() && newData.val() >= data.val() && newData.val() <= data.val() + 900))"
          },
          "d": {
            ".validate": "newData.isString() && newData.val().matches(/^(m|t|d)$/)"
          },
          "m": {
            "$mode": {
              ".validate": "$mode.matches(/^(naiwa|hole|walk|orbit|menu)$/) && newData.isNumber() && ((!data.exists() && newData.val() >= 0 && newData.val() <= 900) || (data.exists() && newData.val() >= data.val() && newData.val() <= data.val() + 900))"
            }
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "d": {
        "$day": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && $day.matches(/^20[0-9][0-9]-[01][0-9]-[0-3][0-9]$/)",
            ".validate": "newData.isNumber() && ((!data.exists() && newData.val() >= 0 && newData.val() <= 900) || (data.exists() && newData.val() >= data.val() && newData.val() <= data.val() + 900)) && newData.val() <= 86400"
          }
        }
      }
    }
  }
}
