{
  "rules": {
    ".read": false,
    ".write": false,
    "presence": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['name', 'mode', 'x', 'z', 'y', 'h', 'color', 't'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
        },
        "mode": {
          ".validate": "newData.isString() && newData.val().matches(/^(orbit|walk|naiwa|hole)$/)"
        },
        "x": {
          ".validate": "newData.isNumber() && newData.val() >= -700 && newData.val() <= 700"
        },
        "z": {
          ".validate": "newData.isNumber() && newData.val() >= -700 && newData.val() <= 700"
        },
        "y": {
          ".validate": "newData.isNumber() && newData.val() >= -700 && newData.val() <= 700"
        },
        "h": {
          ".validate": "newData.isNumber() && newData.val() >= -7 && newData.val() <= 7"
        },
        "car": {
          ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9]{1,12}$/)"
        },
        "color": {
          ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{6}$/)"
        },
        "t": {
          ".validate": "newData.isNumber() && newData.val() === now"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "looks": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.isString() && newData.val().length <= 120 && newData.val().matches(/^[a-z0-9_,]*$/)"
      }
    },
    "boards": {
      "$board": {
        ".read": "$board === 'hole2' || $board === 'hole' || $board === 'stunt' || $board === 'rich'",
        ".indexOn": [
          "value"
        ],
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && ($board === 'hole2' || $board === 'hole' || $board === 'stunt' || $board === 'rich')",
          ".validate": "newData.hasChildren(['name', 'value', 'ts']) && (!data.exists() || newData.child('value').val() >= data.child('value').val())",
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
          },
          "value": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && ((($board === 'hole' || $board === 'hole2') && newData.val() <= 100) || ($board !== 'hole' && $board !== 'hole2' && newData.val() <= 10000000))"
          },
          "ts": {
            ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now + 600000"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "saves": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider !== 'anonymous'",
        ".validate": "newData.hasChildren(['data', 'score', 'ts'])",
        "data": {
          ".validate": "newData.isString() && newData.val().length <= 30000"
        },
        "score": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "ts": {
          ".validate": "newData.isNumber() && newData.val() === now"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "stats": {
      ".read": true,
      "p": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['f', 'l', 's'])",
          "f": {
            ".validate": "newData.isString() && newData.val().matches(/^20[0-9][0-9]-[01][0-9]-[0-3][0-9]$/) && (!data.exists() || newData.val() === data.val())"
          },
          "l": {
            ".validate": "newData.isString() && newData.val().matches(/^20[0-9][0-9]-[01][0-9]-[0-3][0-9]$/)"
          },
          "s": {
            ".validate": "newData.isNumber() && ((!data.exists() && newData.val() >= 0 && newData.val() <= 900) || (data.exists() && newData.val() >= data.val() && newData.val() <= data.val() + 900))"
          },
          "d": {
            ".validate": "newData.isString() && newData.val().matches(/^(m|t|d)$/)"
          },
          "m": {
            "$mode": {
              ".validate": "$mode.matches(/^(naiwa|hole|walk|orbit|menu)$/) && newData.isNumber() && ((!data.exists() && newData.val() >= 0 && newData.val() <= 900) || (data.exists() && newData.val() >= data.val() && newData.val() <= data.val() + 900))"
            }
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "d": {
        "$day": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && $day.matches(/^20[0-9][0-9]-[01][0-9]-[0-3][0-9]$/)",
            ".validate": "newData.isNumber() && ((!data.exists() && newData.val() >= 0 && newData.val() <= 900) || (data.exists() && newData.val() >= data.val() && newData.val() <= data.val() + 900)) && newData.val() <= 86400"
          }
        }
      }
    }
  }
}
